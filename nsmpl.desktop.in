[Desktop Entry]
Type=Application
Version=1.0
Name=nsmpl
GenericName=Audio Sample Tool
Comment=Browse, loop, edit and publish audio samples to Nostr (ndisc suite)
Exec=@BINDIR@/nsmpl
Icon=@ICONDIR@/nsmpl.svg
Terminal=false
Categories=AudioVideo;Audio;Utility;
Keywords=audio;samples;loop;edit;nostr;smpl;
StartupNotify=true
